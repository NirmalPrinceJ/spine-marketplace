          "kind": "skill",
          "delivery": "catalog-template",
          "reads": ["Active Work context", "Available actions"],
          "capabilityIds": ["cap-get_active_context", "cap-get_available_actions"],
          "output": "Evidence brief listing the context and actions available to the signed-in actor",
          "note": "Inspect the context and capabilities the Platform actually grants for the selected Work."
        },
        {
          "id": "skill-continuity-handoff",
          "name": "Prepare an IW-Continuity handoff",
          "kind": "skill",
          "delivery": "catalog-template",
          "reads": ["Work ID", "Permitted continuity", "Prepared Work"],
          "capabilityIds": ["cap-get_my_continuity", "cap-get_work", "cap-get_prepared_work"],
          "output": "Scoped handoff brief with Work ID, decisions, pending commitments and next action",
          "note": "Use permitted context and evidence references to prepare a handoff for an authorized participant."
        }
