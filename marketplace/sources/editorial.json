          "delivery": "catalog-template",
          "reads": ["Work ID", "Approved destination host", "Scoped handoff context"],
          "trigger": "The Work owner requests a handoff to an authorized host or participant.",
          "skillIds": ["skill-spine-network-discovery", "skill-continuity-handoff"],
          "approval": {
            "reviewer": "Authorized Work owner or delegate",
            "requiredFor": "Confirming the recipient and the exact context allowed to travel"
          },
          "output": "Scoped handoff and a resume checkpoint for the same Work ID",
          "verification": "Open the Work on the destination through Spine Network MCP after sign-in. Confirm the Work ID, current decisions, pending commitments and effective access against Platform.",
          "note": "Use IW-Continuity Bridge to resume shared Work with the authorized context and the latest verified outcomes."
        },
        {
          "id": "workflow-spine-network-context",
          "name": "Open governed Work in Spine Network MCP",
          "kind": "workflow",
          "delivery": "catalog-template",
          "trigger": "A signed-in user opens or resumes permitted Work from a supported host.",
          "skillIds": ["skill-spine-network-discovery"],
          "approval": {
            "reviewer": "Authorized workspace approver",
            "requiredFor": "Any consequential action proposed from the context review"
          },
          "output": "Work context brief with evidence, available capabilities and a next action",
          "verification": "Confirm the returned Work ID and evidence references against the authorized workspace view.",
          "note": "Resolve permitted context through the shared Spine Network MCP entry."
        }
